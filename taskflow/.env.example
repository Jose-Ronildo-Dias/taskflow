# TaskFlow — variáveis de ambiente para execução local com Docker Compose.
# Copie para .env (cp .env.example .env) e ajuste. NUNCA versione o .env.

# ---- Obrigatória ----
# Senha do PostgreSQL. Gere uma própria, por exemplo: openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=

# ---- Banco de dados (opcionais) ----
DB_NAME=taskflow
DB_USER=taskflow

# ---- Portas publicadas no host (opcionais) ----
FRONTEND_PORT=8080
# Backend direto (Swagger, depuração); publicado somente em 127.0.0.1
BACKEND_PORT=8081

# ---- Aplicação ----
# Endereço público do frontend. Entra nos links de recuperação de senha e na lista de CORS.
# Se omitido, usa http://localhost:${FRONTEND_PORT}
APP_PUBLIC_URL=http://localhost:8080
# true somente quando o site for servido por HTTPS (produção)
COOKIE_SECURE=false
# Documentação OpenAPI em /swagger-ui.html do backend. Mantenha false em produção.
SWAGGER_ENABLED=true
# Duração da sessão (formato Spring: 7d, 12h...)
SESSION_TIMEOUT=7d
# Custo do BCrypt (padrão 12)
BCRYPT_STRENGTH=12
RATE_LIMIT_ENABLED=true

# ---- E-mail (recuperação de senha) ----
# Com MAIL_ENABLED=false nenhum e-mail é enviado e o aviso fica no log.
MAIL_ENABLED=false
MAIL_FROM=no-reply@exemplo.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# SOMENTE desenvolvimento: imprime o link de redefinição no log. Nunca em produção.
MAIL_LOG_LINKS=false
