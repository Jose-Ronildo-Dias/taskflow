map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${PORT};
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 64k;

    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # API: o navegador fala somente com este servidor (mesma origem), então os cookies de sessão
    # e CSRF continuam de primeira parte. O backend é resolvido a cada 30 s, não só na inicialização.
    location /api/ {
        set $backend_url "${BACKEND_URL}";
        proxy_pass $backend_url;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_SNI};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_redirect off;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        expires -1;
        try_files $uri /index.html;
    }
}
